# Deepfake Detector Configuration
# Copy this file to .env and update the values

# Security (REQUIRED - Change in production!)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Application Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deepfake_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# Model Configuration
MODEL_PATH=./models/weights
EFFICIENTNET_MODEL=efficientnet_b0_deepfake.pth
XCEPTION_MODEL=xception_deepfake.pth
ENSEMBLE_THRESHOLD=0.5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# AWS S3 (Optional - for cloud file storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# Analysis Settings
VIDEO_FRAME_SAMPLE_RATE=10
MIN_FACE_SIZE=64
CONFIDENCE_THRESHOLD=0.7
HEATMAP_RESOLUTION=224

# Cleanup
AUTO_DELETE_AFTER_HOURS=24

# Frontend (for frontend .env)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
